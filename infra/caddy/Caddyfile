# Caddyfile — PRODUCTION
#
# Yêu cầu image build từ infra/caddy/Dockerfile (có plugin caddy-dns/cloudflare).
# Image `caddy:2-alpine` gốc sẽ KHÔNG khởi động được với file này.
#
# Biến môi trường bắt buộc: ACME_EMAIL, CF_API_TOKEN
#   CF_API_TOKEN chỉ cần quyền Zone:DNS:Edit trên đúng zone nentang.vn.
#   Không dùng Global API Key.
{
	email {env.ACME_EMAIL}

	# Caddy ≥2.8 đã GỠ BỎ `interval` và `burst`. Để lại → Caddy không khởi động.
	# `ask` là lá chắn DUY NHẤT: mọi handshake tới hostname chưa có chứng chỉ đều
	# gọi nó. tls-authorize tự giới hạn tần suất chạm database.
	on_demand_tls {
		ask http://tls-authorize:3010/internal/tls/authorize
	}

	servers {
		# Caddy là thứ duy nhất chạm Internet; không có proxy nào trước nó.
		# Vì vậy KHÔNG tin X-Forwarded-For từ bên ngoài.
		trusted_proxies static private_ranges
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

# ── Quản trị nhà bán hàng: MỘT origin duy nhất (ADR-005) ─────────────────────
# CSP: seller-admin tự đặt theo TỪNG RESPONSE, edge KHÔNG đặt nữa (ADR-011).
#
# Vì sao bỏ hẳn thay vì "sửa cho khớp": trình duyệt áp GIAO hai policy, mà policy ở đây là
# chuỗi TĨNH — nó không thể chứa nonce đổi theo từng response. Giữ lại thì mọi giá trị đều
# sai: thiếu script-src ⇒ rơi về `default-src 'none'` ⇒ CHẶN SẠCH JS admin ở prod trong khi
# dev vẫn chạy tốt (Caddyfile.dev không đặt CSP) — đúng cái bẫy ADR-011 §Ràng buộc 1 mô tả;
# còn đặt 'unsafe-inline' để "cho qua" thì nếu app lỡ không gửi policy, edge một mình cho
# phép MỌI script nội tuyến — mất sạch lớp bảo vệ mà nhìn vào vẫn tưởng còn.
#
# ⇒ app là NGUỒN DUY NHẤT của CSP admin. An toàn vì mọi trang đi qua đúng một cửa
# `sendHtml()` trong apps/seller-admin/src/http.js, và mặc định ở đó là khoá cứng.
# scripts/security-scan.sh CHẶN việc vô tình thêm lại `header Content-Security-Policy`
# vào block này — nếu không, lần sau ai đó "khôi phục cho chắc" sẽ giết JS admin ở prod
# mà dev không hề báo.
admin.nentang.vn {
	import security_headers
	header Cache-Control "private, no-store"
	reverse_proxy seller-admin:3001
}

# ── Webhook thanh toán: host riêng, ổn định, KHÔNG lộ admin/API ──────────────
# SePay/Casso POST tới đây. Subdomain nền tảng đã biết trước → DNS-01 (cloudflare),
# không cần on-demand. Chỉ route /webhooks/* tới payment; còn lại 404.
hooks.nentang.vn {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import security_headers
	header Cache-Control "no-store"
	# Webhook Messenger (0122) — ĐẶT TRƯỚC @hooks vì @hooks nuốt cả /webhooks/*.
	# Caddy xét handle theo THỨ TỰ trong block, nên cụ thể phải đứng trên tổng quát.
	@fbhook path /webhooks/messenger
	handle @fbhook {
		reverse_proxy messenger:3072
	}
	@hooks path /webhooks/*
	handle @hooks {
		reverse_proxy payment:3070
	}
	# Nhận đơn từ phần mềm ngoài (0120) — Pancake/n8n/Zapier POST kèm Bearer khoá
	# kết nối của shop. Ở CHUNG host webhook chứ không phải admin.nentang.vn: đây là
	# host máy-gọi-máy, không cookie, không giao diện. Chỉ ĐÚNG đường dẫn này tới
	# seller; mọi thứ khác trong block vẫn rơi xuống 404 bên dưới, nên API seller
	# không vì thế mà lộ ra Internet.
	@ingest path /ingest/*
	handle @ingest {
		reverse_proxy seller:3040
	}
	handle {
		respond 404
	}
}

# ── CDN ảnh: CHỈ bucket public của MinIO (không lộ admin/API/bucket private) ──
cdn.nentang.vn {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import security_headers
	@media path /media-public/*
	handle @media {
		reverse_proxy minio:9000
	}
	handle {
		respond 404
	}
}

# ── Trang CÔNG TY (apex nentang.vn + www) — landing marketing ────────────────
# `*.nentang.vn` KHÔNG khớp apex (chỉ subdomain 1 nhãn). Nếu thiếu block này, apex
# rơi vào catch-all on-demand → `ask` từ chối (isReserved coi nentang.vn là tên miền
# nền tảng) → handshake hỏng → https://nentang.vn KHÔNG mở được. Đã biết trước ⇒ DNS-01.
# storefront thấy host ∈ PLATFORM_ROOT_HOSTS → render landing (không phải shop).
nentang.vn, www.nentang.vn {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import security_headers
	# Self-serve signup (0091): /signup* → service signup (SSR no-JS, vai app_signup). TRƯỚC catch-all.
	handle /signup* {
		reverse_proxy signup:3064
	}
	handle {
		reverse_proxy storefront:3050
	}
}

# ── Storefront trên subdomain nền tảng ───────────────────────────────────────
# Wildcard ⇒ bắt buộc DNS-01 ⇒ bắt buộc plugin cloudflare.
*.nentang.vn {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import security_headers

	# Đường JSON đặt đơn (POST /checkout) BỎ QUA lớp chống bot no-JS; khách thật dùng
	# POST /checkout/place. Chặn ở biên (e2e chạy nội bộ, không qua Caddy nên vẫn gọi được).
	@checkout_json {
		method POST
		path /checkout
	}
	respond @checkout_json 404
	@checkout path /cart /cart/* /checkout /checkout/*
	handle @checkout {
		reverse_proxy checkout:3060
	}
	# Tài khoản khách (0083): /account* → service account (cùng host shop → cookie
	# __Host-cust_session chia sẻ với storefront + checkout). Service tự đặt CSP/no-store.
	@account path /account /account/*
	handle @account {
		reverse_proxy account:3062
	}
	handle {
		reverse_proxy storefront:3050
	}
}

# ── Storefront trên tên miền riêng của khách (ADR-003, ADR-004) ──────────────
# Catch-all. Chứng chỉ cấp on-demand, chỉ sau khi `ask` trả 200.
# /cart* /checkout* → checkout (tự đặt no-store); còn lại → storefront.
https:// {
	tls {
		on_demand
	}
	import security_headers

	@checkout_json {
		method POST
		path /checkout
	}
	respond @checkout_json 404
	@checkout path /cart /cart/* /checkout /checkout/*
	handle @checkout {
		reverse_proxy checkout:3060
	}
	# Tài khoản khách (0083): /account* → service account (cùng host shop → cookie
	# __Host-cust_session chia sẻ với storefront + checkout). Service tự đặt CSP/no-store.
	@account path /account /account/*
	handle @account {
		reverse_proxy account:3062
	}
	handle {
		reverse_proxy storefront:3050
	}
}

# ── HTTP → HTTPS ─────────────────────────────────────────────────────────────
# Phải giữ :80 mở: Let's Encrypt dùng HTTP-01 cho các domain on-demand.
http:// {
	redir https://{host}{uri} 308
}
