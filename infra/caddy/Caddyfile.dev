# Caddyfile — DEV / smoke test TLS on-demand
#
# Khác bản production DUY NHẤT ở chỗ cấp chứng chỉ: ở đây dùng CA nội bộ của
# Caddy (`issuer internal`) thay vì ACME/Let's Encrypt. Toàn bộ cơ chế rủi ro —
# catch-all host, gọi `ask`, tôn trọng 200/403, cache, fail-closed — là y hệt.
#
# Chạy được offline, không giới hạn số lần thử, không đốt quota Let's Encrypt.
{
	# Admin API để kiểm tra cert đã cấp. KHÔNG publish port này ra host.
	admin 0.0.0.0:2019

	# Caddy ≥2.8 đã GỠ BỎ `interval` và `burst` — để lại chúng thì Caddy không
	# khởi động. Hệ quả: `ask` là lá chắn DUY NHẤT chống cấp chứng chỉ tràn lan.
	# tls-authorize tự giới hạn tần suất tra cứu database (xem src/ratelimit.js).
	on_demand_tls {
		ask http://tls-authorize:3010/internal/tls/authorize
	}

	log {
		output stdout
		format json
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

# ── Chuyển hướng HTTP → HTTPS ────────────────────────────────────────────────
# Ở production, Caddy tự chèn handler ACME HTTP-01 vào block này trước redirect.
http:// {
	redir https://{host}{uri} 308
}

# ── Dịch vụ auth (host cố định, cert nội bộ) ─────────────────────────────────
# Origin cố định để cookie __Host-session (yêu cầu Secure+HTTPS) hoạt động, và
# để smoke test có Origin hợp lệ khi gọi các endpoint đổi trạng thái.
auth.localtest {
	tls internal
	import security_headers
	header Cache-Control "no-store"
	reverse_proxy auth:3020
}

# ── Admin web (BFF) cho nhà bán hàng ─────────────────────────────────────────
# Host cố định để cookie __Host-session hoạt động và Origin hợp lệ khi POST.
admin.localtest {
	tls internal
	import security_headers
	# Ảnh public (logo, ảnh SP) phục vụ CÙNG origin admin → CSP 'self' cho phép, trình
	# duyệt tới được (khác với minio:9000 nội bộ). Bucket public đọc ẩn danh (initMedia).
	handle /media-public/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy seller-admin:3001
	}
}

# ── Webhook thanh toán (host riêng, cert nội bộ) ─────────────────────────────
# Prod dùng hooks.nentang.vn. Tách host riêng để URL webhook ổn định, không phụ
# thuộc tên miền shop, và không lộ admin/API sau cùng origin.
hooks.localtest {
	tls internal
	import security_headers
	header Cache-Control "no-store"
	# Webhook Messenger (0122) — ĐẶT TRƯỚC handle tổng quát của payment.
	@fbhook path /webhooks/messenger
	handle @fbhook {
		reverse_proxy messenger:3072
	}
	# Nhận đơn từ phần mềm ngoài (0120) — mirror prod: chỉ ĐÚNG /ingest/* tới
	# seller, phần còn lại vẫn là payment như trước.
	@ingest path /ingest/*
	handle @ingest {
		reverse_proxy seller:3040
	}
	handle {
		reverse_proxy payment:3070
	}
}

# ── Host CỐ ĐỊNH mô phỏng tên miền shop (chỉ để test routing catch-all qua edge)
# Cùng logic tách /cart* → checkout, còn lại → storefront như catch-all, nhưng cert
# nội bộ cố định nên smoke-edge không cần dựng shop + on-demand TLS.
shop.localtest {
	tls internal
	import security_headers
	@checkout path /cart /cart/* /checkout /checkout/*
	handle @checkout {
		reverse_proxy checkout:3060
	}
	# Tài khoản khách (0083): /account* → service account (KHỚP Caddyfile prod —
	# thiếu route này thì icon 👤 rơi vào storefront → 404, bug đã gặp thật ở dev).
	@account path /account /account/*
	handle @account {
		reverse_proxy account:3062
	}
	handle /media-public/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy storefront:3050
	}
}

# ── Trang CÔNG TY (apex nentang.vn + www) — landing marketing của nền tảng ──────
# storefront nhận ra host ∈ PLATFORM_ROOT_HOSTS → render landing (không phải shop).
# Khối apex RIÊNG vì `*.nentang.vn` chỉ khớp subdomain 1 nhãn, KHÔNG khớp apex.
# Local: thêm `127.0.0.1 nentang.vn www.nentang.vn` vào hosts để mở https://nentang.vn:8443
nentang.vn, www.nentang.vn {
	tls internal
	import security_headers
	# Self-serve signup (0091): /signup* → service signup (SSR no-JS, vai app_signup). TRƯỚC catch-all.
	handle /signup* {
		reverse_proxy signup:3064
	}
	handle /media-public/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy storefront:3050
	}
}

# ── Tên miền con onboarding của nền tảng (*.nentang.vn) — cert nội bộ wildcard ──
# Prod: đây là wildcard DNS-01 (Let's Encrypt). Dev: CA nội bộ ký cert wildcard,
# KHÔNG on-demand → KHÔNG qua `ask` (ask CHẶN *.nentang.vn vì isReserved coi đó là
# tên miền nền tảng, không cấp on-demand). Nhờ vậy storefront của shop mới tạo
# (subdomain onboarding <slug>.nentang.vn) MỞ ĐƯỢC ở local. Cùng logic tách
# /cart* → checkout, còn lại → storefront như catch-all.
*.nentang.vn {
	tls internal
	import security_headers
	@checkout path /cart /cart/* /checkout /checkout/*
	handle @checkout {
		reverse_proxy checkout:3060
	}
	@account path /account /account/*
	handle @account {
		reverse_proxy account:3062
	}
	handle /media-public/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy storefront:3050
	}
}

# ── Catch-all: mọi hostname lạ ───────────────────────────────────────────────
# Site block không có hostname → khớp mọi Host. Vì không biết trước tên miền,
# Caddy BẮT BUỘC phải dùng on-demand TLS. Mỗi handshake tới một domain chưa có
# chứng chỉ sẽ gọi `ask` ở trên.
https:// {
	tls {
		issuer internal
		on_demand
	}

	import security_headers

	# /cart* /checkout* → dịch vụ checkout (ghi đơn, tự đặt Cache-Control: no-store).
	# Còn lại → storefront (duyệt, tự đặt public cache cho trang, no-store cho 404).
	# Mỗi dịch vụ làm chủ header cache của mình → không nhân đôi (bài học Ngày 10).
	@checkout path /cart /cart/* /checkout /checkout/*
	handle @checkout {
		reverse_proxy checkout:3060
	}
	@account path /account /account/*
	handle @account {
		reverse_proxy account:3062
	}
	handle /media-public/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy storefront:3050
	}
}
